# =============================================================================
# BlueMarket Nigeria — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# =============================================================================

# --- Required at startup -------------------------------------------------------
# Supabase project URL and the PUBLIC (publishable / anon) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# New projects: sb_publishable_... ; older projects: the "anon" JWT key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
# Public base URL of this app (used for auth redirects and payment callbacks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never prefix with NEXT_PUBLIC_) ------------------------------
# Needed ONLY for the payment webhook/callback and the notification outbox worker.
# New projects: sb_secret_... ; older projects: the service_role JWT key.
SUPABASE_SECRET_KEY=
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Optional: payment provider (leave empty to use sandbox/offline only) ------
# Only "paystack" is implemented. Set after the product owner selects a provider.
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=

# --- Optional: email notifications (Resend) -------------------------------------
RESEND_API_KEY=
EMAIL_FROM="BlueMarket Nigeria <no-reply@example.com>"

# --- Optional: SMS notifications ------------------------------------------------
# Generic HTTPS bridge: we POST {"to","message"} JSON with a bearer token.
# Point it at a small adapter for your approved SMS provider.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- Optional: support contact shown on Help page --------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
